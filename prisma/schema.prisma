generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Appointment {
  id                String   @id
  ticketNumber      Int      @unique @default(autoincrement())
  driverName        String
  vehicleNumber     String
  appointmentDate   DateTime @db.Date
  vacationStartDate DateTime? @db.Date
  vacationEndDate   DateTime? @db.Date
  permitType        String   @default("")
  permitStartDate   DateTime? @db.Date
  permitEndDate     DateTime? @db.Date
  permitDate        DateTime? @db.Date
  permitStartTime   String   @default("")
  permitEndTime     String   @default("")
  swapFromDate      DateTime? @db.Date
  swapToDate        DateTime? @db.Date
  appointmentReason String
  email             String
  phone             String
  assignedExecutive String   @default("")
  scheduledStartTime String @default("")
  scheduledEndTime   String @default("")
  status            String   @default("pendiente")
  dateChangePending Boolean  @default(false)
  dateChangeMessage String   @default("")
  createdByType              String   @default("conductor")
  createdByExecutiveName     String   @default("")
  driverApprovalPending      Boolean  @default(false)
  driverApprovalRejected     Boolean  @default(false)
  driverApprovalMessage      String   @default("")
  rejectionMessage           String   @default("")
  observation                String   @default("")
  evidenceImageFileName      String   @default("")
  evidenceImageMimeType      String   @default("")
  evidenceImageData          String   @default("") @db.Text
  driverGroupCodeSnapshot           String @default("")
  driverGroupNameSnapshot           String @default("")
  driverCategoryCodeSnapshot        String @default("")
  driverCategoryNameSnapshot        String @default("")
  driverThursdayGroupCodeSnapshot   String @default("")
  driverThursdayGroupNameSnapshot   String @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  dailySchedules       DailySchedule[]
  dailyScheduleEvents  DailyScheduleEvent[]

  @@index([status])
  @@index([assignedExecutive])
  @@index([appointmentReason])
  @@index([createdAt])
  @@index([vehicleNumber])
  @@index([appointmentDate])
}

model AppointmentReason {
  id                         String   @id @default(uuid())
  value                      String   @unique
  label                      String
  allowsExecutiveAssignment  Boolean  @default(false)
  usesAppointmentDuration    Boolean  @default(false)
  appointmentDurationMinutes Int      @default(30)
  usesServiceStartTime       Boolean  @default(false)
  serviceStartTime           String   @default("")
  usesDateRange              Boolean  @default(false)
  usesPermitDetails          Boolean  @default(false)
  usesDaySwap                Boolean  @default(false)
  requiresObservation        Boolean  @default(false)
  allowsAttachment           Boolean  @default(false)
  requiresAttachment         Boolean  @default(false)
  visibleToDriver            Boolean  @default(true)
  isActive                   Boolean  @default(true)
  restrictedWeekdays         String   @default("")
  requiresBusinessDayAdvance Boolean  @default(false)
  businessDaysAdvance        Int      @default(0)
  weekdayBusinessAdvance     String   @default("")
  sortOrder                  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([visibleToDriver])
}

model Executive {
  id                String   @id @default(uuid())
  name              String   @unique
  email             String   @default("")
  isActive          Boolean  @default(true)
  dailyLimitEnabled Boolean  @default(false)
  dailyLimitMax     Int?
  lunchBreakEnabled Boolean  @default(false)
  lunchBreakStart   String   @default("")
  lunchBreakEnd     String   @default("")
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model DriverGroup {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  subgroups        DriverSubgroup[]
  drivers          DriverOwner[]
  shiftDefinitions ShiftDefinition[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

enum DriverSubgroupType {
  CATEGORY
  THURSDAY_GROUP
}

model DriverSubgroup {
  id                       String                     @id @default(uuid())
  code                     String
  name                     String
  type                     DriverSubgroupType
  isActive                 Boolean                    @default(true)
  sortOrder                Int                        @default(0)
  groupId                  String
  group                    DriverGroup                @relation(fields: [groupId], references: [id])
  assignments              DriverSubgroupAssignment[]
  shiftDefinitionsAsCategory ShiftDefinition[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@unique([groupId, type, code])
  @@index([groupId, type, isActive])
  @@index([isActive])
  @@index([sortOrder])
}

model DriverSubgroupAssignment {
  id         String         @id @default(uuid())
  driverId   String
  subgroupId String
  driver     DriverOwner    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  subgroup   DriverSubgroup @relation(fields: [subgroupId], references: [id])
  createdAt  DateTime       @default(now())

  @@unique([driverId, subgroupId])
  @@index([driverId])
  @@index([subgroupId])
}

model DriverOwner {
  id                     String    @id @default(uuid())
  vehicleNumber          String    @unique
  fullName               String
  email                  String    @default("")
  rut                    String    @default("")
  licenseExpiryDate      DateTime? @db.Date
  birthDate              DateTime? @db.Date
  landlinePhone          String    @default("")
  mobilePhone            String    @default("")
  address                String    @default("")
  recordStatus           String    @default("V")
  isConductor            Boolean   @default(false)
  isPropietario          Boolean   @default(false)
  municipalLicense       String    @default("")
  shifts                 String    @default("")
  groupId                String?
  group                  DriverGroup? @relation(fields: [groupId], references: [id])
  subgroupAssignments    DriverSubgroupAssignment[]
  emergencyContactName   String    @default("")
  emergencyContactEmail  String    @default("")
  emergencyContactPhone  String    @default("")
  licensePlate           String    @default("")
  inspectionExpiryDate   DateTime? @db.Date
  vehicleType            String    @default("")
  subscriptionDate       DateTime? @db.Date
  passwordHash           String?
  tempPasswordSentAt     DateTime?
  mustChangePassword     Boolean   @default(false)
  isActive               Boolean   @default(true)
  shiftAssignments       DriverShiftAssignment[]
  dailySchedules         DailySchedule[]
  blocks                 DriverBlock[]
  longTripRestrictions   DriverLongTripRestriction[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([isActive])
  @@index([fullName])
  @@index([recordStatus])
  @@index([licensePlate])
  @@index([groupId])
}

model Propietario {
  id                    String    @id @default(uuid())
  importKey             String    @unique
  vehicleNumber         String    @default("")
  post                  String    @default("")
  fullName              String
  firstName             String    @default("")
  lastName              String    @default("")
  secondLastName        String    @default("")
  rut                   String    @default("")
  email                 String    @default("")
  landlinePhone         String    @default("")
  mobilePhone           String    @default("")
  address               String    @default("")
  postalCode            String    @default("")
  city                  String    @default("")
  province              String    @default("")
  bankName              String    @default("")
  bankAccount           String    @default("")
  bankAccountType       String    @default("")
  accountHolder         String    @default("")
  titularRut            String    @default("")
  titularEmail          String    @default("")
  titularBankName       String    @default("")
  titularBankAccount    String    @default("")
  bankBic               String    @default("")
  paymentMethod         String    @default("")
  paymentDay            String    @default("")
  notes                 String    @default("")
  branchOffice          String    @default("")
  area                  String    @default("")
  costCenter            String    @default("")
  accountingAccount     String    @default("")
  isVip                 Boolean   @default(false)
  gender                String    @default("")
  recordStatus          String    @default("V")
  licenseExpiryDate     DateTime? @db.Date
  birthDate             DateTime? @db.Date
  incorporationDate     DateTime? @db.Date
  deactivationDate      DateTime? @db.Date
  emergencyContactName  String    @default("")
  emergencyContactEmail String    @default("")
  emergencyContactPhone String    @default("")
  isActive              Boolean   @default(true)
  status                String    @default("activo")
  inactiveReason          String    @default("")
  activationReason        String    @default("")
  desvinculacionReason    String    @default("")
  desvinculacionDays      Int       @default(0)
  desvinculadoUntil       DateTime? @db.Date
  bankGuaranteePdfFileName String   @default("")
  bankGuaranteePdfData     String   @default("") @db.Text
  isProvisionalBankData    Boolean  @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([isActive])
  @@index([fullName])
  @@index([rut])
  @@index([vehicleNumber])
}

model PropietarioBank {
  id        String   @id @default(uuid())
  name      String   @unique
  bankBic   String   @default("")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model Holiday {
  id                  String   @id @default(uuid())
  date                DateTime @unique @db.Date
  name                String
  year                Int
  scope               String   @default("nacional")
  holidayType         String   @default("")
  region              String   @default("")
  commune             String   @default("")
  isIrrenunciable     Boolean  @default(false)
  businessDaysAdvance Int      @default(15)
  isActive            Boolean  @default(true)
  source              String   @default("manual")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([year])
  @@index([isActive])
}

model AccessUser {
  id                 String    @id @default(uuid())
  email              String    @unique
  fullName           String    @default("")
  passwordHash       String?
  isSuperAdmin       Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  tempPasswordSentAt DateTime?
  isActive           Boolean   @default(true)
  canSolicitudes     Boolean   @default(false)
  canCalendario      Boolean   @default(false)
  canMotivos         Boolean   @default(false)
  canEjecutivos      Boolean   @default(false)
  canConductores     Boolean   @default(false)
  canPropietarios    Boolean   @default(false)
  canPagoPropietario Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([isActive])
  @@index([isSuperAdmin])
}

/// Estados diarios parametrizables de la planificación mensual.
model OperationalStatus {
  id                     String          @id @default(uuid())
  code                   String          @unique
  name                   String
  color                  String          @default("#64748b")
  icon                   String          @default("")
  priority               Int             @default(100)
  indicatesAvailability  Boolean         @default(false)
  blocksAssignments      Boolean         @default(false)
  isActive               Boolean         @default(true)
  sortOrder              Int             @default(0)
  baseDailySchedules     DailySchedule[] @relation("DailyBaseStatus")
  effectiveDailySchedules DailySchedule[] @relation("DailyEffectiveStatus")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([isActive])
  @@index([priority])
  @@index([sortOrder])
}

/// Definición de turno operativo (mantenedor Turnos).
model ShiftDefinition {
  id                   String                  @id @default(uuid())
  code                 String                  @unique
  name                 String
  description          String                  @default("") @db.Text
  groupId              String?
  group                DriverGroup?            @relation(fields: [groupId], references: [id])
  categorySubgroupId   String?
  categorySubgroup     DriverSubgroup?         @relation(fields: [categorySubgroupId], references: [id])
  startTime            String                  @default("")
  endTime              String                  @default("")
  crossesMidnight      Boolean                 @default(false)
  isActive             Boolean                 @default(true)
  color                String                  @default("#0b5cab")
  validFrom            DateTime?               @db.Date
  validTo              DateTime?               @db.Date
  saturdayRule         String                  @default("default")
  sundayRule           String                  @default("default")
  holidayRule          String                  @default("default")
  cycleLengthDays      Int                     @default(0)
  cycleStartDate       DateTime?               @db.Date
  observation          String                  @default("") @db.Text
  patternId            String?
  pattern              ShiftPattern?           @relation(fields: [patternId], references: [id])
  dayRules             ShiftDayRule[]
  assignments          DriverShiftAssignment[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([isActive])
  @@index([groupId])
  @@index([categorySubgroupId])
  @@index([patternId])
}

model ShiftDayRule {
  id                String          @id @default(uuid())
  shiftDefinitionId String
  shiftDefinition   ShiftDefinition @relation(fields: [shiftDefinitionId], references: [id], onDelete: Cascade)
  /// ISO weekday: 1 = lunes … 7 = domingo.
  weekday           Int
  works             Boolean         @default(true)
  startTime         String          @default("")
  endTime           String          @default("")
  durationMinutes   Int             @default(0)
  defaultStatusCode String          @default("TRABAJA")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([shiftDefinitionId, weekday])
  @@index([shiftDefinitionId])
}

model ShiftPattern {
  id                  String                  @id @default(uuid())
  code                String                  @unique
  name                String
  description         String                  @default("") @db.Text
  cycleLengthDays     Int                     @default(7)
  baseDate            DateTime?               @db.Date
  holidayApplication  String                  @default("default")
  weekendApplication  String                  @default("default")
  isActive            Boolean                 @default(true)
  days                ShiftPatternDay[]
  shiftDefinitions    ShiftDefinition[]
  assignments         DriverShiftAssignment[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([isActive])
}

model ShiftPatternDay {
  id        String       @id @default(uuid())
  patternId String
  pattern   ShiftPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  dayOffset Int
  statusCode String      @default("TRABAJA")
  startTime String       @default("")
  endTime   String       @default("")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([patternId, dayOffset])
  @@index([patternId])
}

/// Asignación histórica de turno/patrón a un conductor-móvil.
model DriverShiftAssignment {
  id                String           @id @default(uuid())
  driverOwnerId     String
  driverOwner       DriverOwner      @relation(fields: [driverOwnerId], references: [id], onDelete: Cascade)
  shiftDefinitionId String?
  shiftDefinition   ShiftDefinition? @relation(fields: [shiftDefinitionId], references: [id])
  patternId         String?
  pattern           ShiftPattern?    @relation(fields: [patternId], references: [id])
  effectiveFrom     DateTime         @db.Date
  effectiveTo       DateTime?        @db.Date
  isActive          Boolean          @default(true)
  observation       String           @default("") @db.Text
  createdByEmail    String           @default("")
  dailySchedules    DailySchedule[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([driverOwnerId, effectiveFrom])
  @@index([shiftDefinitionId])
  @@index([patternId])
  @@index([isActive])
}

model MonthlySchedule {
  id               String          @id @default(uuid())
  year             Int
  month            Int
  status           String          @default("draft")
  generatedAt      DateTime?
  generatedByEmail String          @default("")
  notes            String          @default("") @db.Text
  days             DailySchedule[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([year, month])
  @@index([status])
}

model DailySchedule {
  id                 String                 @id @default(uuid())
  monthlyScheduleId  String?
  monthlySchedule    MonthlySchedule?       @relation(fields: [monthlyScheduleId], references: [id])
  date               DateTime               @db.Date
  driverOwnerId      String
  driverOwner        DriverOwner            @relation(fields: [driverOwnerId], references: [id], onDelete: Cascade)
  vehicleNumber      String
  shiftAssignmentId  String?
  shiftAssignment    DriverShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id])
  baseStatusId       String?
  baseStatus         OperationalStatus?     @relation("DailyBaseStatus", fields: [baseStatusId], references: [id])
  effectiveStatusId  String?
  effectiveStatus    OperationalStatus?     @relation("DailyEffectiveStatus", fields: [effectiveStatusId], references: [id])
  appointmentId      String?
  appointment        Appointment?           @relation(fields: [appointmentId], references: [id])
  driverBlockId      String?
  driverBlock        DriverBlock?           @relation(fields: [driverBlockId], references: [id])
  observation        String                 @default("") @db.Text
  changeOrigin       String                 @default("generated")
  isManualOverride   Boolean                @default(false)
  /// Horario efectivo del día (copiado del turno o ajustado manualmente).
  startTime          String                 @default("")
  endTime            String                 @default("")
  /// Posición 0-based en el ciclo rotativo (si aplica).
  cyclePosition      Int?
  modifiedByEmail    String                 @default("")
  modifiedAt         DateTime?
  version            Int                    @default(1)
  events             DailyScheduleEvent[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([driverOwnerId, date])
  @@index([date])
  @@index([vehicleNumber, date])
  @@index([monthlyScheduleId])
  @@index([effectiveStatusId])
  @@index([appointmentId])
  @@index([driverBlockId])
  @@index([isManualOverride])
}

model DailyScheduleEvent {
  id              String        @id @default(uuid())
  dailyScheduleId String
  dailySchedule   DailySchedule @relation(fields: [dailyScheduleId], references: [id], onDelete: Cascade)
  appointmentId   String?
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id])
  eventType       String        @default("appointment")
  startAt         DateTime?
  endAt           DateTime?
  label           String        @default("")
  metadata        String        @default("") @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([dailyScheduleId])
  @@index([appointmentId])
  @@index([eventType])
}

model BlockReason {
  id                   String        @id @default(uuid())
  code                 String        @unique
  name                 String
  requiresManualUnlock Boolean       @default(false)
  blocksAllServices    Boolean       @default(true)
  blocksLongTripsOnly  Boolean       @default(false)
  isActive             Boolean       @default(true)
  sortOrder            Int           @default(0)
  blocks               DriverBlock[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model DriverBlock {
  id                   String          @id @default(uuid())
  driverOwnerId        String
  driverOwner          DriverOwner     @relation(fields: [driverOwnerId], references: [id], onDelete: Cascade)
  blockReasonId        String
  blockReason          BlockReason     @relation(fields: [blockReasonId], references: [id])
  startsAt             DateTime
  endsAt               DateTime?
  observation          String          @default("") @db.Text
  evidenceFileName     String          @default("")
  evidenceMimeType     String          @default("")
  evidenceData         String          @default("") @db.Text
  blocksAllServices    Boolean         @default(true)
  blocksLongTripsOnly  Boolean         @default(false)
  requiresManualUnlock Boolean         @default(false)
  status               String          @default("scheduled")
  createdByEmail       String          @default("")
  unlockedAt           DateTime?
  unlockedByEmail      String          @default("")
  unlockType           String          @default("")
  unlockReason         String          @default("")
  isActive             Boolean         @default(true)
  dailySchedules       DailySchedule[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([driverOwnerId, startsAt])
  @@index([blockReasonId])
  @@index([status])
  @@index([isActive])
}

/// Restricción independiente de “Tercer fichero”.
model DriverLongTripRestriction {
  id             String      @id @default(uuid())
  driverOwnerId  String
  driverOwner    DriverOwner @relation(fields: [driverOwnerId], references: [id], onDelete: Cascade)
  status         String      @default("enabled")
  startsAt       DateTime?
  endsAt         DateTime?
  reason         String      @default("")
  observation    String      @default("") @db.Text
  createdByEmail String      @default("")
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([driverOwnerId, isActive])
  @@index([status])
}

model AuditLog {
  id            String   @id @default(uuid())
  module        String
  action        String
  entityType    String
  entityId      String   @default("")
  previousValue String   @default("") @db.Text
  newValue      String   @default("") @db.Text
  reason        String   @default("")
  origin        String   @default("manual")
  userEmail     String   @default("")
  createdAt     DateTime @default(now())

  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@index([userEmail, createdAt])
}
